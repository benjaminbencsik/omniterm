<Window x:Class="OmniTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniTerm" Height="820" Width="1320" MinHeight="650" MinWidth="1000"
        Background="#111827" Foreground="#F9FAFB">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="OmniTerm" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Native Windows coding agent" Foreground="#9CA3AF" Margin="0,0,0,16" />

                    <TextBlock Text="AI provider" FontWeight="SemiBold" />
                    <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderCombo_SelectionChanged">
                        <ComboBoxItem Content="OpenAI" Tag="openai" IsSelected="True" />
                        <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                        <ComboBoxItem Content="Google Gemini" Tag="gemini" />
                    </ComboBox>

                    <TextBlock Text="API endpoint" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="EndpointBox" Text="https://api.openai.com/v1" IsReadOnly="True" />

                    <TextBlock Text="API key" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <PasswordBox x:Name="ApiKeyBox" Margin="4" Padding="6" />
                    <TextBlock Text="Kept only while OmniTerm is open." Foreground="#9CA3AF" FontSize="11" Margin="4,0,4,6" />

                    <Button Content="Load models" Click="LoadModels_Click" />
                    <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox x:Name="ModelCombo" IsEditable="True" Text="gpt-5-mini" />

                    <Separator Margin="0,14" />
                    <Button Content="Choose workspace" Click="ChooseWorkspace_Click" />
                    <TextBlock Text="Workspace" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="WorkspaceText" Text="Not selected" TextWrapping="Wrap" Foreground="#D1D5DB" Margin="4" />

                    <Separator Margin="0,14" />
                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#93C5FD" Margin="4" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="#1F2937" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Chat" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left" />
                    <Button Content="Clear" Click="ClearChat_Click" DockPanel.Dock="Right" />
                </DockPanel>
                <TextBox x:Name="ChatTranscript" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#111827"
                         Foreground="#F9FAFB" BorderThickness="0" FontFamily="Segoe UI" FontSize="14" />
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" ToolTip="Ask OmniTerm a coding question" />
                    <Button Grid.Column="1" Content="Send" Width="90" Click="Send_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="4" Background="#1F2937" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Workspace files" FontSize="20" FontWeight="Bold" />
                <ListBox x:Name="FileList" Grid.Row="1" Margin="4" SelectionChanged="FileList_SelectionChanged"
                         Background="#111827" Foreground="#F9FAFB" BorderThickness="0" />
                <TextBlock Grid.Row="2" Text="Preview" FontWeight="SemiBold" Margin="4,8,4,0" />
                <TextBox x:Name="FilePreview" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="#111827" Foreground="#F9FAFB"
                         FontFamily="Consolas" BorderThickness="0" />
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Text="git status" />
                    <Button Grid.Column="1" Content="Run" Click="RunCommand_Click" />
                </Grid>
                <TextBox x:Name="CommandOutput" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="#F9FAFB"
                         FontFamily="Consolas" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
